@model IEnumerable<Shop_Example.Dtoes.Admin.Comment.CommentDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>جدیدترین کامنت ها که تایید نشدن</h1>
<p>
    این کامنت ها در حال حاضر در سایت قابل نمایش هستند. اما تاکنون توسط شما تایید نشده اند
</p>
<p>
    <a asp-controller="Comment" asp-action="AllComments" class="btn btn-info">نمایش همه کامنت ها</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                عنوان
            </th>
            <th>
                متن
            </th>
            <th>
                تعداد ستاره ها
            </th>
            <th>
                نقاط قوت
            </th>
            <th>
                نقاط ضعف
            </th>
            <th>
                زمان ارسال
            </th>
            <th>
                نام کاربر
            </th>
            <th>
                نام محصول
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr comment-id="@item.Id">
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Body)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AvgStars)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StreaghtPoint)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.WeakPoint)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TimeCrate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FullName)
                </td>
                <td>
                    <a asp-controller="Product" asp-action="Detail" asp-route-ProductId="@item.ProductId">
                        @Html.DisplayFor(modelItem => item.ProductName)
                    </a>
                </td>
                <td>
                    <button onclick="ConfirmComment(@item.Id)" class="btn btn-success">تایید کامنت</button>
                    <button onclick="DeleteComment(@item.Id)" class="btn btn-warning">حذف کامنت</button>

                    @if (item.IsBlocked == false)
                    {
                        <button onclick="BlockUser('@item.UserId')" class="btn btn-outline-danger">بلاک کاربر</button>

                    }
                    else
                    {
                        <button onclick="UnBlockUser('@item.UserId')" class="btn btn-success">آنبلاک کاربر</button>
                    }
                </td>

            </tr>
        }
    </tbody>
</table>


@section Scripts{

    <script src="~/JsProject/Admin/JsControllCommentUser.js"></script>


    <script>

        function ConfirmComment(Id) {

            if (confirm("آیا از تایید کردن این کامنت مطمئن هستید؟") == true) {

                $.ajax({
                    url: "/Admin/Comment/Confirm/" + Id,
                    method: "Get"
                }).done(function (result) {

                    if (result == true) {

                        $("tr[comment-id='" + Id + "']").fadeOut().remove();

                        alert("کامنت مورد نظر با موفقیت تایید شد");
                    }
                });

            }
        }

        function DeleteComment(Id) {

            if (confirm("آیا از حذف کردن کامنت مورد نظر مطمئن هستید؟") == true) {

                $.ajax({
                    url: "/Admin/Comment/Delete/" + Id,
                    method: "Delete"
                }).done(function (result) {

                    if (result == true) {
                        $("tr[comment-id='" + Id + "']").fadeOut().remove();

                        alert("کامنت مورد نظر با موفقیت حذف شد");
                    }

                });
            }
        }

    </script>
} 