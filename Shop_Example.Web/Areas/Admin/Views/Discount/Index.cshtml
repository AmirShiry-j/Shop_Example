@model IEnumerable<Shop_Example.Dtoes.Admin.Discount.DiscountDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>کدهای تخفیف</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<a asp-area="Admin" asp-controller="Discount" asp-action="SendEmailForTest" class="btn btn-success">برای تست سرویس ایمیل (موقت)</a> 
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ValueDiscount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CouponCode)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr discount-id="@item.Id">
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ValueDiscount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CouponCode)
            </td>
            <td>
                <a class="btn btn-info" asp-action="Detail" asp-route-DiscountId="@item.Id">Detial</a>
                <button class="btn btn-warning" onclick="DeleteDiscount(@item.Id)" >Delete</button>
            </td>
        </tr>
}
    </tbody>
</table>


@section Scripts{

    <script>
        function DeleteDiscount(Id) {

            if (confirm("آیا از حذف کردن این تخفیف مطمئن هستید؟") == true) {
                $.ajax({
                    url: "/Discount/Delete/" + Id,
                    method: "Get",
                    success: function (result) {
                        if (result == true) {
                            $("tr[discount-id='" + Id + "']").fadeOut();
                        }
                    }
                });
            }

        }
    </script>
}