@model IEnumerable<Product>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>Index</h1>

<a class="btn btn-info" asp-controller="Product" asp-action="Create">Create Product</a>

<table class="table table-bordered table-hover table-striped">
    <tr>
        <th>نام محصول</th>
        <th>قیمت محصول</th>
        <th>برند</th>
        <th>تصویر</th>
        <th>دستورات</th>
    </tr>
    @if (Model.Any())
    {
        @foreach (var item in Model)
        {
            <tr id="row_@item.Id">
                <th>@item.Name</th>
                <th>@item.Price.ToString("#,0")</th>
                <th>@item.Brand</th>
                <th>
                    <img class="img-thumbnail" width="150" height="100" src="/ProductImages/@item.Image"/>
                </th>
                <th>
                    <a class="btn btn-sm btn-danger" onclick="Delete(@item.Id)">
                        <i class="fa fa-trash-o"></i>
                    </a> |
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                        <i class="fa fa-edit"></i>
                    </a> |
                    <a class="btn btn-info btn-sm" asp-controller="ProductImages" asp-action="Index" asp-route-id="@item.Id">
                        Images
                    </a>
                    <a class="btn btn-info btn-sm" asp-controller="ProductFeature" asp-action="Index" asp-route-ProductId="@item.Id">
                        Features
                    </a>
                    @if (item.Warranty != null)
                    {
                        <a class="btn btn-info btn-sm" asp-controller="Warranty" asp-action="Index" asp-route-ProductId="@item.Id">
                            دارای گارانتی
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-warning btn-sm" asp-controller="Warranty" asp-action="Index" asp-route-ProductId="@item.Id">
                            بدون گارانتی
                        </a>
                    }
                </th>
            </tr>

        }
    }
    else
    {
        <tr>
            <th colspan="5">
                <h4>چیزی برای نمایش وجود ندارد</h4>
            </th>
        </tr>
    }
</table>

@section Scripts
{
    <script>
        function Delete(id) {
            if (confirm("Are You Sure From Delete ?") == true) {
                $.get("/Admin/P/Delete/" + id,
                    function() {
                        $("#row_" + id).hide("slow");
                    });
            }
        }
    </script>
}
