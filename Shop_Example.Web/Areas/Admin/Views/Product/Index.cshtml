@addTagHelper *, LazZiya.TagHelpers


@model Shop_Example.Dtoes.Admin.Product.ProductListVM
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<br />
<br />

<a class="btn btn-info" asp-controller="Product" asp-action="Create">ایجاد محصول جدید</a>
<a class="btn btn-info" href="/Admin/Category/GetProducts?CategoryId=0">
    <i class="fa fa-cloud"></i> دسته بندی نشده ها
</a>
<br />
<br />

<table class="table table-bordered table-hover table-striped">
    <tr>
        <th>نام محصول</th>
        <th>قیمت محصول</th>
        <th>نمایش در سایت</th>
        <th>تصویر</th>
        <th>دستورات</th>
    </tr>
    @if (Model.Products != null && Model.Products.Any())
    {
        @foreach (var item in Model.Products)
        {
            <tr id="row_@item.Id">

                @if (item.Displayed)
                {
                    <th>
                        <a asp-area="" asp-controller="Product" asp-action="Detail" asp-route-ProductId="@item.Id">
                            @item.Name
                        </a>
                    </th>
                }
                else
                {
                    <th>
                        @item.Name
                    </th>
                }


                <th>@item.Price.ToString("n0")</th>
                <th>
                    @if (item.Displayed)
                    {
                        <button class="btn btn-success">بله</button>
                    }
                    else
                    {
                        <button class="btn btn-warning">خیر</button>
                    }
                </th>
                <th>
                    <img class="img-thumbnail" width="150" height="100" src="/ProductImages/@item.Image" />
                </th>
                <th>
                    <a class="btn btn-sm btn-danger" onclick="Delete(@item.Id)">
                        <i class="fa fa-trash-o"></i>
                    </a> |
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                        <i class="fa fa-edit"></i>
                    </a> |
                    <a class="btn btn-info btn-sm" asp-controller="ProductImages" asp-action="Index" asp-route-id="@item.Id">
                        تصاویر
                    </a>
                    <a class="btn btn-info btn-sm" asp-controller="ProductFeature" asp-action="Index" asp-route-ProductId="@item.Id">
                        ویژگی ها
                    </a>
                    <a class="btn btn-info btn-sm" asp-controller="ProductInformation" asp-action="Index" asp-route-ProductId="@item.Id">
                        مشخصات فنی
                    </a>
                    @if (item.HasWarranty)
                    {
                        <a class="btn btn-info btn-sm" asp-controller="Warranty" asp-action="Index" asp-route-ProductId="@item.Id">
                            دارای گارانتی
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-warning btn-sm" asp-controller="Warranty" asp-action="Index" asp-route-ProductId="@item.Id">
                            بدون گارانتی
                        </a>
                    }
                </th>
            </tr>

        }
    }
    else
    {
        <tr>
            <th colspan="5">
                <h4>چیزی برای نمایش وجود ندارد</h4>
            </th>
        </tr>
    }
</table>

<div class="pagination-product">
    <nav aria-label="Page navigation example">
        <paging total-records="Model.CountAllItems"
                page-no="Model.Page"
                page-size="Model.CounInPage"
                show-page-size-nav="false"
                show-first-last="true"
                show-prev-next="true"
                show-total-pages="false"
                show-total-records="false"
                query-string-key-page-no="Page"
                query-string-value="@@(Request.QueryString.Value)">
        </paging>

    </nav>
</div>

@section Scripts
{
    <script>
        function Delete(id) {
            if (confirm("آیا مطمئنید که میخواد این محصول رو حذف کنید؟ ?") == true) {
                $.get("/Admin/P/Delete/" + id,
                    function () {
                        $("#row_" + id).hide("slow");
                    });
            }
        }
    </script>
}
