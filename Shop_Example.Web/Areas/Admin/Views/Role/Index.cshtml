@model IEnumerable<Shop_Example.Dtoes.Admin.Role.RoleListDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>نقش ها</h1>

<p>
    <a asp-action="Create">اضافه کردن نقش جدید</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                <i class="fa fa-male text-info"></i>
                @Html.DisplayNameFor(model => model.CountUsers)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>

                    @Html.DisplayFor(modelItem => item.CountUsers)

                    &nbsp;

                    @if (item.CountUsers > 0)
                    {

                        @Html.ActionLink("List Users", "UsersOfRole", "User", new { RoleId = item.Id, area = "Admin" })

                    }
                </td>
                <td>
                    @if (item.Name != "Admin" && item.Name != "Manager")
                    {
                        <button class="btn btn-warning" onclick="DeleteRole('@item.Id')">حذف نقش در سایت</button>
                    }

                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts{

    <script>

        function DeleteRole(RoleId) {

            if (confirm('آیا از حذف کردن این نقش از سایت مطمئن هستید؟') == true) {

                $.ajax({
                    url: "/Admin/Role/Delete",
                    data: { RoleId: RoleId },
                    success: function () {

                        window.location.reload();
                    }
                });

            }
        }

    </script>

}