@inject Microsoft.AspNetCore.Authorization.IAuthorizationService _authorizeService

<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>پنل ادمین</title>

    <!-- Core CSS - Include with every page -->
    <link href="/Admin/css/bootstrap.min.css" rel="stylesheet">
    <link href="/Admin/css/bootstrap-rtl.css" rel="stylesheet">
    <link href="/Admin/font-awesome/css/font-awesome.css" rel="stylesheet">

    <!-- Page-Level Plugin CSS - Blank -->
    <link href="/Admin/css/sb-admin.css" rel="stylesheet">
    <!-- SB Admin CSS - Include with every page -->

    @RenderSection("Css", false)

</head>

<body>

    <div id="wrapper">

        <nav class="navbar navbar-default navbar-fixed-top" role="navigation" style="margin-bottom: 0; ">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".sidebar-collapse">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="index.html">پنل ادمین</a>
            </div>

            <div class="navbar-default navbar-static-side" role="navigation">
                <div class="sidebar-collapse">
                    <ul class="nav" id="side-menu">

                        <li>
                            <a asp-controller="Product" asp-action="Index"><i class="fa fa-dashboard fa-fw"></i>محصولات</a>
                        </li>

                        @if (_authorizeService.AuthorizeAsync(User, "IsAdminUser").Result.Succeeded)
                        {
                            <li>
                                <a asp-controller="User" asp-action="Index"><i class="fa fa-user fa-fw"></i>کاربران</a>
                            </li>
                            <li>
                                <a asp-controller="Role" asp-action="Index"><i class="fa fa-apple fa-fw"></i>نقش ها</a>
                            </li>
                        }
                        <li>
                            <a asp-controller="Category" asp-action="Index"><i class="fa fa-sitemap fa-fw"></i>دسته بندی ها</a>
                        </li>
                        <li>
                            <a asp-controller="Slider" asp-action="Index"><i class="fa fa-instagram fa-fw"></i>اسلایدر ها</a>
                        </li>
                        <li>
                            <a asp-controller="Comment" asp-action="Index"><i class="fa fa-comment fa-fw"></i>کامنت ها</a>
                        </li>
                        <li>
                            <a asp-controller="Discount" asp-action="Index"><i class="fa fa-android fa-fw"></i>تخفیفات</a>
                        </li>
                        <li>
                            <a asp-controller="HomeCategory" asp-action="Index"><i class="fa fa-adjust fa-fw"></i>دسته بندی ها در صفحه اصلی</a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Home" asp-action="Index"><i class="fa fa-home fa-fw"></i>صفحه اصلی سایت</a>
                        </li>
                    </ul>
                    <!-- /#side-menu -->
                </div>
                <!-- /.sidebar-collapse -->
            </div>
            <!-- /.navbar-static-side -->
        </nav>

        <div id="page-wrapper" >
            <div class="row">
                <div class="col-lg-12">
                    @RenderBody()
                </div>
                <!-- /.col-lg-12 -->
            </div>
            <!-- /.row -->
        </div>
        <!-- /#page-wrapper -->

    </div>
    <!-- /#wrapper -->
    <!-- Core Scripts - Include with every page -->
    <script src="/Admin/js/jquery-1.10.2.js"></script>
    <script src="/Admin/js/bootstrap.min.js"></script>
    <script src="/Admin/js/plugins/metisMenu/jquery.metisMenu.js"></script>

    <!-- Page-Level Plugin Scripts - Blank -->
    <!-- SB Admin Scripts - Include with every page -->
    <script src="/Admin/js/sb-admin.js"></script>

    <!-- Page-Level Demo Scripts - Blank - Use for reference -->
    @RenderSection("Scripts", false)

</body>

</html>
