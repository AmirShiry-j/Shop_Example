                        <li class="sidebar-search">
                            <div class="input-group custom-search-form">
                                <input type="text" class="form-control" placeholder="Search...">
                                <span class="input-group-btn">
                                    <button class="btn btn-default" type="button">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </span>
                            </div>
                            <!-- /input-group -->
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Index"><i class="fa fa-table fa-fw"></i>H.O.M.E </a>
                        </li>
                        @if (_authorizeService.AuthorizeAsync(User, "IsAdminUser").Result.Succeeded)
                        {
                            <li>
                                <a asp-controller="User" asp-action="Index"><i class="fa fa-user fa-fw"></i>Users</a>
                            </li>
                            <li>
                                <a asp-controller="Role" asp-action="Index"><i class="fa fa-sitemap fa-fw"></i>Roles</a>
                            </li>
                        }

                        <li>
                            <a asp-controller="Product" asp-action="Index"><i class="fa fa-dashboard fa-fw"></i>Products</a>
                        </li>
                        <li>
                            <a asp-controller="Category" asp-action="Index"><i class="fa fa-files-o fa-fw"></i>Categories</a>
                        </li>
                        <li>
                            <a asp-controller="Slider" asp-action="Index"><i class="fa fa-files-o fa-fw"></i>Sliders</a>
