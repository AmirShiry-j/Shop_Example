                        </li>
                        <li>
                            <a asp-controller="HomeCategory" asp-action="Index"><i class="fa fa-files-o fa-fw"></i>Categories in HomePage</a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Home" asp-action="Index"><i class="fa fa-sitemap fa-fw"></i>H.O.M.E Public</a>
