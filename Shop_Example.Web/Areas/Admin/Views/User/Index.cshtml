@addTagHelper *, LazZiya.TagHelpers


@model Shop_Example.Dtoes.Admin.User.IndexPageUsersVM

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>کاربران</h1>

<p>
    <a class="btn btn-default" asp-action="Create">اضافه کردن کاربر جدید</a>
    <a class="btn btn-info" asp-action="BlockUsers">لیست کاربران بلاک شده (برای کامنت)</a>
</p>
<form asp-action="Index" class="d-flex">
    <label>Search With FullName</label>
    <div class="d-flex">
        <div class="col-5">
            <input class="form-control col-5" required name="Search" />
        </div>

        <input type="submit" class="btn btn-sm btn-success" value="Search" />
    </div>

</form>
<table class="table">
    <thead>
        <tr>
            <th>
                نام کامل
            </th>
            <th>
                ایمیل
            </th>
            <th>
                وضعیت ایمیل
            </th>
            <th>
                شماره موبایل
            </th>

            <th>
                نقش ها
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Users != null && Model.Users.Any())
        {

            @foreach (var item in Model.Users)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.FullName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Email)
                    </td>
                    <td>
                        @if (item.ConfirmedEmail)
                        {
                            <span class="alert alert-success">
                                تایید شده
                            </span>
                        }
                        else
                        {
                            <span class="alert alert-warning">
                                تایید نشده
                            </span>
                        }
                    </td>
                    <td>
                        @if (item.PhoneNumber != null)
                        {

                            @Html.DisplayFor(modelItem => item.PhoneNumber)

                        }
                        else
                        {

                            @:ثبت نشده


                        }
                    </td>
                    <td>

                        <a asp-action="RolesOfUser" asp-route-UserId="@item.Id">
                            @Html.DisplayFor(modelItem => item.Roles)
                        </a>

                    </td>
                    <td>
                        @Html.ActionLink("نقش جدید", "AddRoleToUser", "User", new { UserId = item.Id, area = "Admin" })
                        |
                        @Html.ActionLink("جزئیات", "Detail", "User", new { UserId = item.Id, area = "Admin" })
                    </td>
                </tr>
            }

        }
    </tbody>
</table>


<div class="pagination-product">
    <nav aria-label="Page navigation example">
        <paging total-records="Model.CountAllItems"
                page-no="Model.Page"
                page-size="Model.CounInPage"
                show-page-size-nav="false"
                show-first-last="true"
                show-prev-next="true"
                show-total-pages="false"
                show-total-records="false"
                query-string-key-page-no="Page"
                query-string-value="@@(Request.QueryString.Value)">
        </paging>

    </nav>
</div>