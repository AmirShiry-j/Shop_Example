@model IEnumerable<string>

@using Microsoft.AspNetCore.Identity.EntityFrameworkCore
@inject UserManager<User> _userManager

@{
    ViewData["Title"] = "RolesOfUser";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string UserId = ViewBag.UserId as string;

}

<h1>لیست نقش های کاربر در سایت</h1>

<p>
    <a asp-action="AddRoleToUser" asp-route-UserId="@ViewBag.UserId">اضافه کردن نقش جدید</a>
</p>
<div class="bg bg-success my-3">
    نقش های کاربر با ایمیل @ViewBag.Email :
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                Name
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {

            <tr>
                <td>
                    @item
                </td>
                <td>
                    @if (item == "Admin")
                    {
                        if (_userManager.GetUsersInRoleAsync("Admin").Result.Count > 1)
                        {
                            <button onclick="RemoveRoleToUser('@item')" class="btn btn-warning">Remove</button>
                        }
                        else
                        {
                            <span class="btn btn-outline-dark">تنها ادمین سایت</span>
                        }
                    }
                    else
                    {
                        <button onclick="RemoveRoleToUser('@item')" class="btn btn-warning">Remove</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts{

    <script>

        function RemoveRoleToUser(RoleNamea) {

            if (confirm("آیا میخواهید نقش '" + RoleNamea + "' از کاربر بگیرید؟") == true) {

                $.ajax({
                    url: "/Admin/User/RemoveRoleToUser",
                    data: { RoleName: RoleNamea , UserId: '@UserId' },
                    success: function () {

                        window.location.reload();
                    }
                });

            }
        }
    </script>

}