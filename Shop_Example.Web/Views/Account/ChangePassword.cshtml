@model Shop_Example.Dtoes.Account.ChangePasswordDto

@{
    ViewData["Title"] = "ChangePassword";
    Layout = "~/Views/Shared/_RegisterLayout.cshtml";
}



<div class="Login-to-account mt-4">
    <div class="account-box-content">
        <h4 class="mb-2">تغییر رمز عبور</h4>
        <form asp-action="ChangePassword" method="post" class="form-account text-right">
            <div class="form-account-title">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            </div>
            <div class="form-account-title">

                <label for="NowPassword">رمز عبور فعلی</label>

                <input asp-for="NowPassword" type="password" class="password-input" name="NowPassword">

                <span class="text-danger"
                      asp-validation-for="NowPassword"></span>
            </div>

            <div class="form-account-title">

                <label for="NewPassword">رمز عبور جدید</label>

                <input asp-for="NewPassword" type="password" class="password-input" name="NewPassword">

                <span class="text-danger"
                      asp-validation-for="NewPassword"></span>
            </div>

            <div class="form-account-title">

                <label for="ConfirmPassword">تکرار رمز عبور جدید</label>

                <input asp-for="ConfirmPassword" type="password" class="password-input" name="ConfirmPassword">

                <span class="text-danger"
                      asp-validation-for="ConfirmPassword"></span>
            </div>

            <div class="form-row-account">

                <button class="btn btn-primary btn-login">تغییر رمز عبور</button>

            </div>
        </form>
    </div>
</div>
