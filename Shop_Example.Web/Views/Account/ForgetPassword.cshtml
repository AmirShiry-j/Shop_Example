@model Shop_Example.Dtoes.Account.ForgetPasswordDto

@{
    ViewData["Title"] = "ForgetPassword";
    Layout = "~/Views/Shared/_RegisterLayout.cshtml";
}


<div class="Login-to-account mt-4">
    <div class="account-box-content">
        <h4 class="mb-2">فراموشی گذرواژه</h4>
        <p>گذرواژه خود را فراموش کرده اید؟ ایمیل خود را وارد کنید.</p>
        <form asp-action="ForgetPassword" class="form-account text-right">

            <div class="form-account-title">

                <label for="Email">ایمیل</label>

                <input asp-for="Email" name="Email" type="text" autocomplete="off" class="number-email-input" id="email-phone">

                <span class="text-danger"
                      asp-validation-for="Email"></span>
            </div>

            <div class="form-row-account">
                <button class="btn btn-primary btn-login">بازگردانی رمز عبور</button>
            </div>
        </form>
    </div>
</div>
