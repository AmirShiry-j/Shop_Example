@model Shop_Example.Dtoes.Account.ResetPasswordDto

@{
    ViewData["Title"] = "ResetPassword";
    Layout = "~/Views/Shared/_RegisterLayout.cshtml";
}


<div class="Login-to-account mt-4">
    <div class="account-box-content">
        <h4 class="mb-2">بازنشانی رمز عبور</h4>
        <form asp-action="ResetPassword" method="post" class="form-account text-right">
            <div class="form-account-title">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            </div>
            <div class="form-account-title">

                <label for="password">رمز عبور جدید</label>

                <input asp-for="Password" type="password" class="password-input" name="Password">

                <span class="text-danger"
                      asp-validation-for="Password"></span>
            </div>

            <div class="form-account-title">

                <label for="ConfirmPassword">تکرار رمز عبور جدید</label>

                <input asp-for="ConfirmPassword" type="password" class="password-input" name="ConfirmPassword">

                <span class="text-danger"
                      asp-validation-for="ConfirmPassword"></span>


                <input asp-for="Token" type="hidden" name="Token">
                <input asp-for="UserId" type="hidden" name="UserId">

            </div>

            <div class="form-row-account">

                <button class="btn btn-primary btn-login">تغییر رمز عبور</button>

            </div>
        </form>
    </div>
</div>

