@model Shop_Example.Dtoes.Address.CreateAddressDto

@using Shop_Example.Dtoes.Profile

@{
    ViewData["Title"] = "Create Address";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- profile------------------------------->
<div class="container-main">
    <div class="d-block">
        <section class="profile-home">
            <div class="col-lg">
                <div class="post-item-profile order-1 d-block">
                    <div class="col-lg-3 col-md-3 col-xs-12 pr">
                        <div class="sidebar-profile sidebar-navigation">

                            @await Component.InvokeAsync("ShowMainInfoUser")

                            <section class="profile-box">
                                <ul class="profile-account-navs">
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a href="/Profile/Index" class="">
                                            <i class="mdi mdi-account-outline"></i>
                                            پروفایل
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a href="/Profile/Order" class="">
                                            <i class="mdi mdi-cart"></i>
                                            همه سفارش ها
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a href="/Profile/Favorites" class="">
                                            <i class="mdi mdi-heart"></i>
                                            لیست علاقه مندی
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a href="/Profile/Address" class="active">
                                            <i class="mdi mdi-map-outline"></i>
                                            آدرس ها
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a href="/Profile/Comment" class="">
                                            <i class="mdi mdi-email-open-outline"></i>
                                            نظرات
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a href="/Profile/InfoAccount" class="">
                                            <i class="mdi mdi-tooltip-text-outline"></i>
                                            اطلاعات حساب
                                        </a>
                                    </li>
                                </ul>
                            </section>

                        </div>
                    </div>
                    <div class="col-lg-9 col-md-9 col-xs-12 pl">
                        <div class="profile-content">
                            <div class="profile-stats">
                                <div class="profile-address">
                                    <div class="middle-container">
                                        <form asp-action="Create" method="post" class="form-checkout">

                                            <div class="form-checkout-row">
                                                <label for="name">نام تحویل گیرنده <abbr class="required" title="ضروری" style="color:red;">*</abbr></label>
                                                <input asp-for="RecipientName" type="text" id="name" class="input-name-checkout form-control">
                                                <span asp-validation-for="RecipientName"></span>

                                                <div class="form-checkout-valid-row">

                                                    <label for="province">
                                                        استان
                                                        <abbr class="required" title="ضروری" style="color:red;">*</abbr>
                                                    </label>
                                                    <select asp-for="UnitedId" asp-items="Model.Uniteds" onchange="GetCities()" id="province" class="form-control">
                                                    </select>
                                                    <span asp-validation-for="UnitedId"></span>

                                                    <label for="city">
                                                        شهر
                                                        <abbr class="required" title="ضروری" style="color:red;">*</abbr>
                                                    </label>
                                                    <select asp-for="CityId" asp-items="Model.Cities" id="city" class="form-control">
                                                    </select>
                                                    <span asp-validation-for="CityId"></span>

                                                </div>

                                                <label for="post-code">کد پستی<abbr class="required" title="ضروری" style="color:red;">*</abbr></label>
                                                <input asp-for="PostalCode" type="text" id="post-code" class="input-name-checkout form-control" placeholder="کد پستی را بدون خط تیره بنویسید">
                                                <span asp-validation-for="PostalCode"></span>

                                                <label for="address">
                                                    آدرس
                                                    <abbr class="required" title="ضروری" style="color:red;">*</abbr>
                                                </label>
                                                <textarea asp-for="FullAddress" rows="5" cols="30" id="address" class="textarea-name-checkout form-control"></textarea>
                                                <span asp-validation-for="FullAddress"></span>

                                                <div class="AR-CR">
                                                    <button class="btn-registrar"> ثبت آدرس</button>
                                                    <a asp-controller="Profile" asp-action="Address" class="cancel-edit-address" data-dismiss="modal" aria-label="Close">بازگشت</a>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
<!-- profile------------------------------->

@section Css{
    <link rel="stylesheet" href="~/assets/css/vendor/bootstrap.css">
    <link rel="stylesheet" href="~/assets/css/vendor/owl.carousel.min.css">
    <link rel="stylesheet" href="~/assets/css/vendor/noUISlider.min.css">
    <link rel="stylesheet" href="~/assets/css/vendor/nice-select.css">
}

@section Scripts{
    <script src="~/assets/js/vendor/owl.carousel.min.js"></script>
    <script src="~/assets/js/vendor/jquery.countdown.js"></script>
    <script src="~/assets/js/vendor/ResizeSensor.min.js"></script>
    <script src="~/assets/js/vendor/theia-sticky-sidebar.min.js"></script>
    <script src="~/assets/js/vendor/wNumb.js"></script>
    <script src="~/assets/js/vendor/nouislider.min.js"></script>
    <script src="~/assets/js/vendor/jquery.nice-select.min.js"></script>

    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>

        function GetCities() {

            let dropdown = $('#city');

            dropdown.empty();

            var unitedId = $('#province').val();
            const url = '/Address/GetCities?UnitedId=' + unitedId;

            const p = fetch(url);

            p.then((response) => {

                var JsonFile = response.json();

                JsonFile.then((resJson) => {

                    var answer = resJson.map(function (el) {
                        var arr = [];

                        for (var key in el) {
                            arr.push(el[key]);
                        }
                        return arr;
                    });

                    $.each(answer, function (key, entry) {

                        var str = String(entry);
                        var arrayProp = str.split(',');

                        var text = arrayProp[0];
                        var value = arrayProp[1];

                        dropdown.append($('<option value=' + value + '>' + text + '</option>'));
                    })

                }).catch((errJson) => {

                });

            }).catch((error) => {

            });

        }


    </script>
}

