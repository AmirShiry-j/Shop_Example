@model List<Shop_Example.Dtoes.Product.CategoryWithHisProductsDto>

@inject Shop_Example.DataLayer.Repositorys.UnitOfWorkRepository.Interface.IUnitOfWork _unitOfWork
@{
    var categories = Model;
}



@if (categories != null && categories.Any())
{

    foreach (var category in categories)
    {
        if (category.Products.Any())
        {

            <div class="col-lg-12 col-md-12 col-xs-12 pr order-1 d-block">
                <div class="slider-widget-products slider-content-tabs">
                    <div class="widget widget-product card slider-content-tabs">

                        <header class="card-header header-product">
                            <a asp-controller="Product" asp-action="Index" asp-route-CategoryId="@category.Id">
                                <span class="title-one">@category.Name</span>
                                <h3 class="card-title"></h3>
                            </a>
                        </header>

                        <div class="product-carousel owl-carousel owl-theme owl-rtl owl-loaded owl-drag">
                            <div class="owl-stage-outer">
                                <div class="owl-stage" style="transform: translate3d(0px, 0px, 0px); transition: all 0s ease 0s; width: 2234px;">
                                    @{

                                        foreach (var product in category.Products)
                                        {

                                            <div class="owl-item tab-item" style="width: 309.083px; margin-left: 10px;">
                                                <div class="item">
                                                    <a asp-controller="Product" asp-action="Detail" asp-route-ProductId="@product.ProductId" class="d-block hover-img-link">
                                                        <img src="/ProductImages/@product.Image" class="img-fluid" alt="">
                                                    </a>
                                                    <h2 class="post-title">
                                                        <a asp-controller="Product" asp-action="Detail" asp-route-ProductId="@product.ProductId">
                                                            @product.Name

                                                        </a>
                                                    </h2>
                                                    <div class="price">
                                                        @if (product.LinedPrice != null)
                                                        {
                                                            <del><span>@product.LinedPrice?.ToString("n0")<span>تومان</span></span></del>

                                                        }
                                                        <ins><span>@product.ShowedPrice.ToString("n0")<span>تومان</span></span></ins>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }


                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        }
    }
}

























