@model IEnumerable<Shop_Example.Entities.Billboard.Slider>


@if (Model != null && Model.Any())
{
    <div class="adplacement-container-row mt-4">
        @foreach (var slider in Model)
        {
            <div class="col-6 col-lg-3 pr">
                <a href="@slider.Link" class="adplacement-item">
                    <div class="adplacement-sponsored_box">
                        <img src="/SliderImages/@slider.Src">
                    </div>
                </a>
            </div>
        }
    </div>
}
