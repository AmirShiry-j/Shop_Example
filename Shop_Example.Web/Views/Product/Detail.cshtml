@model Shop_Example.Dtoes.Product.DatailsProductViewModel
@{

    void SetStars(int CountStars)
    {
        int goldStar = CountStars;
        int nullStar = 5 - CountStars;

        for (int i = 1; i <= goldStar; i++)
        {
            <i class="fa fa-star active"></i>
        }
        for (int i = 1; i <= nullStar; i++)
        {
            <i class="fa fa-star"></i>
        }
    }
}

<div class="container-main">
    <div class="d-block">
        <div class="page-content page-row">
            <div class="main-row">
                <div class="col-lg">
                    <div class="product type-product">
