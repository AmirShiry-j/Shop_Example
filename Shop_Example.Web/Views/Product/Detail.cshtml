
@model Shop_Example.Dtoes.Product.DatailsProductViewModel
@{

    void SetStars(int CountStars)
    {
        int goldStar = CountStars;
        int nullStar = 5 - CountStars;

        for (int i = 1; i <= goldStar; i++)
        {
            <i class="fa fa-star active"></i>
        }
        for (int i = 1; i <= nullStar; i++)
        {
            <i class="fa fa-star"></i>
        }
    }
}

<div class="container-main">
    <div class="d-block">
        <div class="page-content page-row">
            <div class="main-row">
                <div class="col-lg">
                    <div class="product type-product">
                        <div class="col-lg-5 col-xs-12 pr d-block" style="padding: 0;">
                            <section class="product-gallery">
                                <div class="gallery">
                                    <div class="gallery-item">
                                        <div>
                                            <ul class="gallery-actions">
                                                <li>
                                                    @if (Model.Favorite)
                                                    {
                                                        <a href="#" id="favorite-btn" ProductId="@Model.Id" class="btn-option add-product-wishes active">
                                                            <i class="mdi mdi-heart-outline"></i>
                                                            <span>محبوب</span>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a href="#" id="favorite-btn" ProductId="@Model.Id" class="btn-option add-product-wishes">
                                                            <i class="mdi mdi-heart-outline"></i>
                                                            <span>محبوب</span>
                                                        </a>
                                                    }
                                                </li>

                                                <li class="Three-dimensional">
                                                    <a href="#" class="btn-option btn-Three-dimensional" data-toggle="modal" data-target="#more-product">
                                                        <i class="mdi mdi-more"></i>
                                                        <span>نمایش بیشتر</span>
                                                    </a>
                                                    <div class="modal fade" id="more-product" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered more-product" role="document">
                                                            <div class="modal-content">
                                                                <div class="modal-body">
                                                                    <!-- تصاویر محصول -->
                                                                    <div id="custom-events">

                                                                        <a href="/ProductImages/@Model.Image">
                                                                            <img src="/ProductImages/@Model.Image" />
                                                                        </a>

                                                                        <a href="/ProductImages/@Model.Image">
                                                                            <img src="/ProductImages/@Model.Image" />
                                                                        </a>
                                                                        @if (Model.SrcImages != null)
                                                                        {
                                                                            foreach (var imgName in Model.SrcImages)
                                                                            {
                                                                                <a href="/ProductImages/@imgName">
                                                                                    <img src="/ProductImages/@imgName" />
                                                                                </a>
                                                                            }
                                                                        }


                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </li>

                                            </ul>
                                        </div>
                                    </div>
                                    <div class="gallery-item">
                                        <div class="gallery-img">
                                            <a href="#">
                                                <img class="zoom-img" id="img-product-zoom" src="/ProductImages/@Model.Image"
                                                     data-zoom-image="/ProductImages/@Model.Image" width="411" />
                                                <div id="gallery_01f" style="width:420px;float:right;">
                                            </a>
                                            <ul class="gallery-items owl-carousel owl-theme" id="gallery-slider">
                                                @if (Model.SrcImages != null)
                                                {
                                                    foreach (var imgName in Model.SrcImages)
                                                    {
                                                        <li class="item">
                                                            <a href="#" class="elevatezoom-gallery active" data-update=""
                                                               data-image="/ProductImages/@imgName"
                                                               data-zoom-image="/ProductImages/@imgName">
                                                                <img src="/ProductImages/@imgName" width="100" />
                                                            </a>
                                                        </li>
                                                    }

                                                }

                                            </ul>
                                        </div>
                                    </div>
                                </div>
                        </div>
                        </section>
                    </div>
                    <div class="col-lg-7 col-xs-12 pl mt-5 d-block">
                        <section class="product-info">
                            <div class="product-headline">
                                <h1 class="product-title">
                                    @Model.Name
                                </h1>
                                <div class="product-guaranteed text-success">
                                    12
                                    <span>فروش موفق</span>
                                </div>
                            </div>
                            <div class="product-attributes">
                                <div class="product-config">
                                    <span class="product-title-en">@Model.Model</span>
                                    <div class="product-rate">
                                        @{

                                            SetStars(Model.ProductStarts);

                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="product-config-wrapper">
                                <div class="product-directory">
                                    <ul>
                                        <li>
                                            <!-- کتگوری ها -->
                                            <span>
                                                <i class="fa fa-archive"></i> دسته:
                                            </span>
                                            @if (Model.Categories != null&&Model.Categories.Any())
                                            {
                                                bool dot = false;
                                                foreach (var category in Model.Categories)
                                                {
                                                    if (dot)
                                                    {
                                                        @:,
                                                    }
                                                    <a asp-controller="Product" asp-action="Index" asp-route-CategoryId="@category.Id" class="product-link product-cat-title">@category.Name</a>
                                                    dot = true;
                                                }
                                            }
                                            else
                                            {
                                                <a href="#" class="product-link product-cat-title">دسته بندی نشده</a>
                                            }
                                        </li>
                                        <li>
                                            <!-- تگ ها -->
                                            <span>
                                                <i class="fa fa-tags"></i> برچسب:
                                            </span>
                                            @if (Model.Tages != null)
                                            {
                                                bool dot = false;
                                                foreach (var tag in Model.Tages)
                                                {
                                                    if (dot)
                                                    {
                                                        @:,
                                                    }
                                                    <a href="/Product/Index?Search=@tag" class="product-link product-tag-title">@tag</a>
                                                    dot = true;
                                                }
                                            }
                                        </li>
                                        <li>
                                            <span>
                                                برند:
                                            </span>
                                            <a href="#" class="product-link product-tag-title">@Model.Brand</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="col=lg-6 col-md-6 col-xs-12 pr">

                                    <div class="product-params pt-3">

                                        <!-- ویژگی های محصول -->
                                        <ul data-title="ویژگی‌های محصول">
                                            @if (Model.ProductFeatures != null)
                                            {
                                                foreach (var feature in Model.ProductFeatures)
                                                {
                                                    <li>
                                                        <span>@feature.DisplayName:</span>
                                                        <span>@feature.Value</span>
                                                    </li>
                                                }
                                            }
                                        </ul>
                                    </div>
                                </div>
                                <div class="col=lg-6 col-md-6 col-xs-12 pr">
                                    <div class="product-seller-info">
                                        <div class="seller-info-changable">
                                            <div class="product-seller-row guarantee">
                                                <span class="title"> گارانتی:</span>
                                                @if (Model.Warranty != null)
                                                {
                                                    <a href="#" class="product-name">@Model.Warranty.Name</a>

                                                }
                                                else
                                                {
                                                    <span href="#" class="product-name">ندارد</span>
                                                }
                                            </div>
                                            <div class="product-seller-row price">
                                                <span class="title"> قیمت:</span>
                                                <a href="#" class="product-name">
                                                    <span class="">
                                                        <del>
                                                            @Model.LinedPrice?.ToString("#,0")
                                                        </del>
                                                    </span>
                                                    <br />
                                                    <span class="amount">
                                                        @Model.ShowedPrice.ToString("#,0")
                                                        <span>تومان</span>
                                                    </span>
                                                </a>
                                            </div>

                                            <div class="product-seller-row add-to-cart">
                                                <a asp-controller="Cart" asp-action="AddToCart" asp-route-ProductId="@Model.Id" class="btn-add-to-cart btn btn-primary">
                                                    <span class="btn-add-to-cart-txt">افزودن به سبد خرید</span>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
            <div class="tabs">
                <div class="tab-box">
                    <ul class="tab nav nav-tabs" id="myTab" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="User-comments-tab" data-toggle="tab" href="#User-comments" role="tab" aria-controls="User-comments" aria-selected="false">
                                <i class="mdi mdi-comment-text-multiple-outline"></i>
                                نظرات کاربران
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" id="Specifications-tab" data-toggle="tab" href="#Specifications" role="tab" aria-controls="Specifications" aria-selected="false">
                                <i class="mdi mdi-format-list-checks"></i>
                                مشخصات
                            </a>
                        </li>

                    </ul>
                </div>
                <div class="col-lg">
                    <div class="tabs-content">
                        <div class="tab-content" id="myTabContent">
                            @*<div class="tab-pane fade show active" id="Review" role="tabpanel" aria-labelledby="Review-tab">
                                    <h2 class="params-headline">نقد و بررسی اجمالی</h2>
                                    <section class="content-expert-summary">
                                        <div class="mask pm-3">
                                            <div class="mask-text">
                                                <p>@Model.Description</p>
                                            </div>
                                            <a href="#" class="mask-handler">
                                                <span class="show-more">+ ادامه مطلب</span>
                                                <span class="show-less">- بستن</span>
                                            </a>
                                            <div class="shadow-box"></div>
                                        </div>
                                    </section>
                                </div>*@


                            @await Component.InvokeAsync("ShowComments", new { ProductId = Model.Id, Page = Model.Page })



                            @await Component.InvokeAsync("ShowInformations", new { ProductId = Model.Id })


                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Css{
    <link rel="stylesheet" href="~/assets/css/vendor/bootstrap.css">
    <link rel="stylesheet" href="~/assets/css/vendor/owl.carousel.min.css">
    <link rel="stylesheet" href="~/assets/css/vendor/noUISlider.min.css">
    <link rel="stylesheet" href="~/assets/css/vendor/lightgallery.css">
    <link rel="stylesheet" href="~/assets/css/vendor/nice-select.css">
}

@section Scripts{
    <script src="~/assets/js/vendor/owl.carousel.min.js"></script>
    <script src="~/assets/js/vendor/jquery.countdown.js"></script>
    <script src="~/assets/js/vendor/lightgallery-all.js"></script>
    <script src="~/assets/js/vendor/jquery.ez-plus.js"></script>
    <script src="~/assets/js/vendor/jquery.nice-select.min.js"></script>

    <script>

        $("ul.gallery-actions li .add-product-wishes").on("click", function (e) {

            e.preventDefault();

            var element = $(this);

            if (!(element.hasClass("disable"))) {
                //for delay
                element.addClass("disable");
                element.css("cursor", "not-allowed");

                var productId = element.attr("ProductId");
                var hasFavorite = element.hasClass("active");

                if (hasFavorite == false) {
                    $.ajax(
                        {
                            url: "/Favorite/Add/" + productId,
                            method: "Post",
                            success: function (result) {

                                if (result == true) {

                                    setTimeout(function () {

                                        element.addClass("active");

                                        element.css("cursor", "pointer");
                                        element.removeClass("disable");

                                    }, 500);
                                }
                            },
                            error: function () {
                                location.replace("/Account/Login");
                            }
                        });
                }
                else {
                    $.ajax(
                        {
                            url: "/Favorite/Remove/" + productId,
                            method: "Delete",
                            success: function (result) {

                                if (result == true) {

                                    setTimeout(function () {

                                        element.removeClass("active");

                                        element.css("cursor", "pointer");
                                        element.removeClass("disable");

                                    }, 500);
                                }
                            },
                            error: function () {
                                location.replace("/Account/Login");
                            }
                        });
                }

            }

        });

        function AddCount(CartItemId) {
            window.location.replace('/cart/add/' + CartItemId);
        }

        function lowCount(CartItemId) {
            window.location.replace('/cart/LowOff/' + CartItemId);
        }

    </script>
}
