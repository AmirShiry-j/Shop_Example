@model Shop_Example.Dtoes.Product.InformationVM
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<div class="tab-pane fade" id="Specifications" role="tabpanel" aria-labelledby="Specifications-tab">
    <article>
        <h2 class="params-headline">
            مشخصات فنی
            <span>@Model.ProductModelName</span>
        </h2>
        <section>
            <ul class="params-list">

                @if (Model.Information != null && Model.Information.Any())
                {
                    @foreach (var item in Model.Information)
                    {
                        <li class="params-list-item">
                            <div class="params-list-key">
                                <span class="block">@item.DisplayName</span>
                            </div>
                            <div class="params-list-value">
                                <span class="block">
                                    @item.Value
                                </span>
                            </div>
                        </li>
                    }

                }

            </ul>
        </section>
    </article>
</div>