@model Shop_Example.Dtoes.Profile.FavoritesViewModel

@{
    ViewData["Title"] = "Favorites";
    Layout = "~/Views/Shared/_Layout.cshtml";

    void SetStars(int CountStars)
    {
        int goldStar = CountStars;
        int nullStar = 5 - CountStars;

        for (int i = 1; i <= goldStar; i++)
        {
            <i class="fa fa-star active"></i>
        }
        for (int i = 1; i <= nullStar; i++)
        {
            <i class="fa fa-star"></i>
        }
    }
}


<!-- profile------------------------------->
<div class="container-main">
    <div class="d-block">
        <section class="profile-home">
            <div class="col-lg">
                <div class="post-item-profile order-1 d-block">
                    <div class="col-lg-3 col-md-3 col-xs-12 pr">
                        <div class="sidebar-profile sidebar-navigation">

                            @await Component.InvokeAsync("ShowMainInfoUser")

                            <section class="profile-box">
                                <ul class="profile-account-navs">
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a asp-action="Index" class="">
                                            <i class="mdi mdi-account-outline"></i>
                                            پروفایل
                                        </a>
                                    </li>
                                    @*<li class="profile-account-nav-item navigation-link-dashboard">
                                            <a asp-action="Order" class="">
                                                <i class="mdi mdi-cart"></i>
                                                همه سفارش ها
                                            </a>
                                        </li>*@
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a asp-action="Favorites" class="active">
                                            <i class="mdi mdi-heart"></i>
                                            لیست علاقه مندی
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a asp-action="Address" class="">
                                            <i class="mdi mdi-map-outline"></i>
                                            آدرس ها
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a asp-action="Comments" class="">
                                            <i class="mdi mdi-email-open-outline"></i>
                                            نظرات
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a asp-action="InfoAccount" class="">
                                            <i class="mdi mdi-tooltip-text-outline"></i>
                                            اطلاعات حساب
                                        </a>
                                    </li>
                                </ul>
                            </section>
                        </div>
                    </div>



                    <div class="col-lg-9 col-md-9 col-xs-12 pl">
                        <div class="profile-content">
                            <div class="profile-stats">
                                <div class="table-favorites">
                                    <table class="table ns-table table-profile-favorites">
                                        <thead>
                                            <tr>
                                                <th scope="col" width="50"> </th>
                                                <th scope="col">نام محصول</th>
                                                <th scope="col">قیمت</th>
                                                <th class="actions-th"></th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @if (Model != null && Model?.Favorites != null)
                                            {
                                                @foreach (var favorite in Model.Favorites)
                                                {
                                                    <tr product-id="@favorite.ProductId">
                                                        <th scope="row">
                                                            <div class="favorites-product-img">
                                                                <img src="/ProductImages/@favorite.ProductImage">
                                                                <div class="product-rate">
                                                                    @{
                                                                        SetStars(favorite.ProductAvgStars);
                                                                    }
                                                                </div>
                                                            </div>
                                                        </th>
                                                        <td>
                                                            <a asp-controller="Product" asp-action="Detail" asp-route-ProductId="@favorite.ProductId">@favorite.ProductName</a>
                                                        </td>
                                                        <td>
                                                            <span class="amount">
                                                                @favorite.ProductPrice.ToString("n0")
                                                                <span>تومان</span>
                                                            </span>
                                                        </td>
                                                        <td class="text-left actions">
                                                            <a class="remove-product remove-product-a" onclick="RemoveFavoriteResponseBig(@favorite.ProductId)"><i class="mdi mdi-close"></i></a>
                                                        </td>
                                                    </tr>
                                                    <tr class="spacer"></tr>
                                                }
                                            }

                                        </tbody>
                                    </table>

                                    @if (Model != null && Model?.Favorites != null)
                                    {
                                        @foreach (var favorite in Model.Favorites)
                                        {
                                            <div product-id="@favorite.ProductId" class="profile-recent-fav">
                                                <a asp-controller="Product" asp-action="Detail" asp-route-ProductId="@favorite.ProductId" class="img-profile-favorites">
                                                    <img src="/ProductImages/@favorite.ProductImage">
                                                </a>
                                                <div class="profile-recent-fav-col">
                                                    <a asp-controller="Product" asp-action="Detail" asp-route-ProductId="@favorite.ProductId">@favorite.ProductName</a>
                                                </div>
                                                <div class="profile-recent-fav-price">
                                                    <span class="amount">
                                                        @favorite.ProductPrice.ToString("n0")
                                                        <span>تومان</span>
                                                    </span>
                                                </div>
                                                <div class="profile-recent-fav-remove">
                                                    <a onclick="RemoveFavoriteResponseSmall(@favorite.ProductId)"><i class="mdi mdi-close"></i></a>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
<!-- profile------------------------------->



@section Css{
    <link rel="stylesheet" href="~/assets/css/vendor/bootstrap.css">
    <link rel="stylesheet" href="~/assets/css/vendor/owl.carousel.min.css">
    <link rel="stylesheet" href="~/assets/css/vendor/noUISlider.min.css">
    <link rel="stylesheet" href="~/assets/css/vendor/nice-select.css">

    <link rel="stylesheet" href="~/Sweetalert2/v11.2.2/sweetalert2.min.css">

}

@section Scripts{
    <script src="~/assets/js/vendor/owl.carousel.min.js"></script>
    <script src="~/assets/js/vendor/jquery.countdown.js"></script>
    <script src="~/assets/js/vendor/ResizeSensor.min.js"></script>
    <script src="~/assets/js/vendor/theia-sticky-sidebar.min.js"></script>
    <script src="~/assets/js/vendor/wNumb.js"></script>
    <script src="~/assets/js/vendor/nouislider.min.js"></script>
    <script src="~/assets/js/vendor/jquery.nice-select.min.js"></script>

    <script src="~/Sweetalert2/v11.2.2/sweetalert2.all.min.js"></script>

    <script src="~/ProfileAlerts/AlertsForChangeImgProfile.js"></script>

    <script src="~/JsProject/Favorite/FavoritesIndex.js"></script>

}





