@model Shop_Example.Dtoes.Profile.FullInfoUserDto

@{
    ViewData["Title"] = "InfoAccount";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- profile------------------------------->
<div class="container-main">
    <div class="d-block">
        <section class="profile-home">
            <div class="col-lg">
                <div class="post-item-profile order-1 d-block">
                    <div class="col-lg-3 col-md-3 col-xs-12 pr">
                        <div class="sidebar-profile sidebar-navigation">

                            @await Component.InvokeAsync("ShowMainInfoUser")

                            <section class="profile-box">
                                <ul class="profile-account-navs">
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a href="/Profile/Index" class="active">
                                            <i class="mdi mdi-account-outline"></i>
                                            پروفایل
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a href="/Profile/Order" class="">
                                            <i class="mdi mdi-cart"></i>
                                            همه سفارش ها
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a href="/Profile/Favorites" class="">
                                            <i class="mdi mdi-heart"></i>
                                            لیست علاقه مندی
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a href="/Profile/Address" class="">
                                            <i class="mdi mdi-map-outline"></i>
                                            آدرس ها
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a href="/Profile/Comments" class="">
                                            <i class="mdi mdi-email-open-outline"></i>
                                            نظرات
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a href="/Profile/InfoAccount" class="">
                                            <i class="mdi mdi-tooltip-text-outline"></i>
                                            اطلاعات حساب
                                        </a>
                                    </li>
                                </ul>
                            </section>
                        </div>
                    </div>
                    <div class="col-lg-9 col-md-9 col-xs-12 pl">
                        <div class="profile-content">
                            <div class="profile-stats">
                                <table class="table table-profile">
                                    <tbody>
                                        <tr>
                                            <td class="w-50">
                                                <div class="title">نام و نام خانوادگی:</div>
                                                <div class="value">@Model.FullName</div>
                                            </td>
                                            <td>
                                                <div class="title">پست الکترونیک :</div>
                                                <div class="value">@Model.Email</div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <div class="title">شماره تلفن همراه:</div>
                                                <div class="value">
                                                    @if (Model.PhoneNumber != null)
                                                    {
                                                        @:@Model.PhoneNumber
                                                    }
                                                    else
                                                    {
                                                        @:ثبت نشده
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="title">وضعیت فعالسازی شماره همراه:</div>
                                                <div class="value">
                                                    @if (Model.IsConfirmedPhoneNumber)
                                                    {
                                                        @:تایید شده
                                                    }
                                                    else
                                                    {
                                                        @:تایید نشده
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <div class="title"> ورود دو مرحله ای:</div>
                                                <div class="value">
                                                    @if (Model.TwoFactorLogin)
                                                    {
                                                        @:فعال است
                                                    }
                                                    else
                                                    {
                                                        @:فعال نیست
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div class="profile">
                                    <ul class="mb-0">
                                        <li class="profile-item">
                                            <div class="title">نام و نام خانوادگی:</div>
                                            <div class="value">@Model.FullName</div>
                                        </li>
                                        <li class="profile-item">
                                            <div class="title">پست الکترونیک :</div>
                                            <div class="value">@Model.Email</div>
                                        </li>
                                        <li class="profile-item">
                                            <div class="title">شماره تلفن همراه:</div>
                                            <div class="value">
                                                @if (Model.PhoneNumber != null)
                                                {
                                                    @:@Model.PhoneNumber
                                                }
                                                else
                                                {
                                                    @:ثبت نشده
                                                }
                                            </div>
                                        </li>
                                        <li class="profile-item">
                                            <div class="title">وضعیت فعالسازی شماره همراه:</div>
                                            <div class="value">
                                                @if (Model.IsConfirmedPhoneNumber)
                                                {
                                                    @:تایید شده
                                                }
                                                else
                                                {
                                                    @:تایید نشده
                                                }
                                            </div>
                                        </li>
                                        <li class="profile-item">
                                            <div class="title">  ورود دو مرحله ای:</div>
                                            <div class="value">
                                                @if (Model.TwoFactorLogin)
                                                {
                                                    @:فعال است
                                                }
                                                else
                                                {
                                                    @:فعال نیست
                                                }
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                                <div class="profile-edit-action">
                                    <a href="/Profile/InfoAccount" class="link-spoiler-edit btn btn-secondary">ویرایش اطلاعات</a>
                                    <a href="/Account/ChangePassword" class="link-spoiler-edit btn btn-secondary">تغییر رمز عبور</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
<!-- profile------------------------------->


@section Css{
    <link rel="stylesheet" href="~/assets/css/vendor/bootstrap.css">
    <link rel="stylesheet" href="~/assets/css/vendor/owl.carousel.min.css">
    <link rel="stylesheet" href="~/assets/css/vendor/noUISlider.min.css">
    <link rel="stylesheet" href="~/assets/css/vendor/nice-select.css">
}

@section Scripts{
    <script src="~/assets/js/vendor/owl.carousel.min.js"></script>
    <script src="~/assets/js/vendor/jquery.countdown.js"></script>
    <script src="~/assets/js/vendor/ResizeSensor.min.js"></script>
    <script src="~/assets/js/vendor/theia-sticky-sidebar.min.js"></script>
    <script src="~/assets/js/vendor/wNumb.js"></script>
    <script src="~/assets/js/vendor/nouislider.min.js"></script>
    <script src="~/assets/js/vendor/jquery.nice-select.min.js"></script>
}