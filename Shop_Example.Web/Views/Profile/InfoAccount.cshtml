@model Shop_Example.Dtoes.Profile.EditUserInfoDto

@{
    ViewData["Title"] = "InfoAccount";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- profile------------------------------->
<div class="container-main">
    <div class="d-block">
        <section class="profile-home">
            <div class="col-lg">
                <div class="post-item-profile order-1 d-block">
                    <div class="col-lg-3 col-md-3 col-xs-12 pr">
                        <div class="sidebar-profile sidebar-navigation">

                            @await Component.InvokeAsync("ShowMainInfoUser")

                            <section class="profile-box">
                                <ul class="profile-account-navs">
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a asp-action="Index" class="">
                                            <i class="mdi mdi-account-outline"></i>
                                            پروفایل
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a asp-action="Order" class="">
                                            <i class="mdi mdi-cart"></i>
                                            همه سفارش ها
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a asp-action="Favorites" class="">
                                            <i class="mdi mdi-heart"></i>
                                            لیست علاقه مندی
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a asp-action="Address" class="">
                                            <i class="mdi mdi-map-outline"></i>
                                            آدرس ها
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a asp-action="Comments" class="">
                                            <i class="mdi mdi-email-open-outline"></i>
                                            نظرات
                                        </a>
                                    </li>
                                    <li class="profile-account-nav-item navigation-link-dashboard">
                                        <a asp-action="InfoAccount" class="active">
                                            <i class="mdi mdi-tooltip-text-outline"></i>
                                            اطلاعات حساب
                                        </a>
                                    </li>
                                </ul>
                            </section>
                        </div>
                    </div>
                    <div class="col-lg-9 col-md-9 col-xs-12 pl">
                        <div class="profile-content">
                            <div class="profile-stats">
                                <div class="profile-address">
                                    <div class="middle-container">
                                        <form action="/Profile/InfoAccount" method="post" class="form-checkout">
                                            <div class="form-checkout-row">
                                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                                <label for="FullName">نام و نام خانوادگی <abbr class="required" title="ضروری" style="color:red;">*</abbr></label>
                                                <input name="FullName" asp-for="FullName" type="text" id="namefirst" class="input-namefirst-checkout form-control">
                                                <span asp-validation-for="FullName"></span>

                                                <label for="Email">ایمیل <abbr class="required" title="ضروری" style="color:red;">*</abbr></label>
                                                <input name="Email" asp-for="Email" type="text" id="email" class="input-email-checkout form-control">
                                                <span asp-validation-for="Email"></span>

                                                <label for="PhoneNumber">شماره همراه </label>
                                                <input name="PhoneNumber" asp-for="PhoneNumber" type="text" id="email" class="input-email-checkout form-control">
                                                <span asp-validation-for="PhoneNumber"></span>

                                                <label for="TwoFactorLogin">ورود دو مرحله ای</label>
                                                <input name="TwoFactorLogin" asp-for="TwoFactorLogin" type="checkbox" id="email" class="input-email-checkout form-check-inline">

                                                <div class="AR-CR">
                                                    <input type="submit" class="btn-registrar" value="ثبت تغییرات "> 
                                                    <a href="/Profile/Index" class="cancel-edit-address" data-dismiss="modal" aria-label="Close">بازگشت</a>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
<!-- profile------------------------------->



@section Css{
    <link rel="stylesheet" href="~/assets/css/vendor/bootstrap.css">
    <link rel="stylesheet" href="~/assets/css/vendor/owl.carousel.min.css">
    <link rel="stylesheet" href="~/assets/css/vendor/noUISlider.min.css">
    <link rel="stylesheet" href="~/assets/css/vendor/nice-select.css">
}

@section Scripts{
    <script src="~/assets/js/vendor/owl.carousel.min.js"></script>
    <script src="~/assets/js/vendor/jquery.countdown.js"></script>
    <script src="~/assets/js/vendor/ResizeSensor.min.js"></script>
    <script src="~/assets/js/vendor/theia-sticky-sidebar.min.js"></script>
    <script src="~/assets/js/vendor/wNumb.js"></script>
    <script src="~/assets/js/vendor/nouislider.min.js"></script>
    <script src="~/assets/js/vendor/jquery.nice-select.min.js"></script>
}