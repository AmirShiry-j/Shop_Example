@model Tuple<Shop_Example.Entities.Models.Product, List<string>>

@{

    Layout = null;

    var product = Model.Item1;
    var imagesNames = Model.Item2;

}

<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-lg-6 pr">
                    <div class="thum-img">
                        <div class="widget widget-product card mb-0">
                            <div class="product-carousel-more owl-carousel owl-theme owl-rtl owl-loaded owl-drag">
                                <div class="owl-stage-outer">
                                    <div class="owl-stage" style="transform: translate3d(1652px, 0px, 0px); transition: all 0.25s ease 0s; width: 2065px;">

                                        <div class="owl-item" style="width: 273px; margin-left: 10px;">
                                            <div class="item">
                                                <a href="#" class="d-block hover-img-link" data-toggle="modal" data-target="#exampleModal">
                                                    <div class="zoom-box">
                                                        <img src="/ProductImages/@product.Image" width="200" height="150"><div class="viewer-box" style="width: 400px; height: 300px; left: 115px; top: 0px;"><img src="/ProductImages/@product.Image" style="width: 600px; height: 600px;"></div><div class="zoom-selector" style="width: 30px; height: 30px;"></div>
                                                        <div class="discount-m">
                                                            <span>10%</span>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>

                                        @if (imagesNames.Count > 0 && imagesNames != null)
                                        {
                                            foreach (var imgName in imagesNames)
                                            {

                                                <div class="owl-item" style="width: 273px; margin-left: 10px;">
                                                    <div class="item">
                                                        <a href="#" class="d-block hover-img-link" data-toggle="modal" data-target="#exampleModal">
                                                            <div class="zoom-box">
                                                                <img src="/ProductImages/@imgName" width="200" height="150"><div class="viewer-box" style="width: 400px; height: 300px; left: 115px; top: 0px;"><img src="/ProductImages/@imgName" style="width: 600px; height: 600px;"></div><div class="zoom-selector" style="width: 30px; height: 30px;"></div>
                                                                <div class="discount-m">
                                                                    <span>10%</span>
                                                                </div>
                                                            </div>
                                                        </a>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 pr">
                    <div class="product-box-modal-title">
                        <h2 class="post-title">
                            <a asp-controller="Product" asp-action="Detail" asp-route-ProductId="@product.Id">
                                @product.Name
                            </a>
                        </h2>
                    </div>
                    <div class="small-gutters align-items-stretch mb-4">
                        <div class="col-lg-12 pr-0 pl-0 pr">
                            <div class="product-box-modal_price mt-12 mt-auto">
                                <div class="price">
                                    <del><span>۳,۵۰۰,۰۰۰<span>تومان</span></span></del>
                                    <ins><span>@product.Price<span>تومان</span></span></ins>
                                </div>
                            </div>
                        </div>
                        <div class="small-gutters">
                            <div class="col-lg-12 mb-8 pr-0 pl-0 pr mt-3">
                                <div class="product-box_action">
                                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-ProductId="@product.Id" class="btn btn-gradient-primary add-to-cart" type="submit">افزودن به سبد</a>
                                    @*<button class="btn btn-gradient-primary add-to-cart" type="submit">افزودن به سبد</button>*@
                                    <a asp-controller="Product" asp-action="Detail" asp-route-ProductId="@product.Id" class="btn btn-outline-dark btn-block">مشاهده جزئیات</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>