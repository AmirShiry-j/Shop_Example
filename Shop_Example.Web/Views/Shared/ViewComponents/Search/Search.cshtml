@model IEnumerable<Shop_Example.Dtoes.Product.CategoryDto>

<form action="#" class="form-search" method="get">
    <input type="search" class="header-search-input" name="search-input" placeholder="نام کالا، برند و یا دسته مورد نظر خود را جستجو کنید…">
    <div class="action-btns">
        <button class="btn btn-search" type="submit">
            <i class="fa fa-search"></i>
        </button>
        <div class="search-filter">
            <div class="form-ui">
                <div class="custom-select-ui">
                    <select class="right">

                        <option value="0">همه دسته ها</option>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var category in Model)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        }

                    </select>
                </div>
            </div>
        </div>
    </div>
</form>